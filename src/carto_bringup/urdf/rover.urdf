<?xml version="1.0"?>

<robot name="rover">

  <!-- ===================== -->
  <!-- BASE                  -->
  <!-- ===================== -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.40 0.20"/>
      </geometry>

      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.40 0.20"/>
      </geometry>
    </collision>

  </link>


  <!-- ===================== -->
  <!-- RPLIDAR               -->
  <!-- ===================== -->

  <link name="laser">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>

  </link>


  <!-- ===================== -->
  <!-- BASE -> LASER         -->
  <!-- ===================== -->

  <joint name="laser_joint" type="fixed">

    <parent link="base_link"/>
    <child link="laser"/>

    <origin
      xyz="0 0 0.15"
      rpy="0 0 0"/>

  </joint>

</robot>
